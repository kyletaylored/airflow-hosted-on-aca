{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "namePrefix": {
      "value": "${NAME_PREFIX=aflo}"
    },
    "postgresAdminUser": {
      "value": "${POSTGRES_ADMIN_USER=airflowadmin}"
    },
    "postgresSkuName": {
      "value": "${POSTGRES_SKU_NAME=Standard_B1ms}"
    },
    "postgresSkuTier": {
      "value": "${POSTGRES_SKU_TIER=Burstable}"
    },
    "postgresLocation": {
      "value": "${POSTGRES_LOCATION}"
    },
    "postgresZone": {
      "value": "${POSTGRES_ZONE}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "airflowAdminUser": {
      "value": "${AIRFLOW_ADMIN_USER=airflow}"
    },
    "airflowAdminPassword": {
      "value": "${AIRFLOW_ADMIN_PASSWORD}"
    },
    "airflowSecretKey": {
      "value": "${AIRFLOW_SECRET_KEY}"
    },
    "assignJobsRole": {
      "value": "${ASSIGN_JOBS_ROLE=true}"
    },
    "resourceTags": {
      "value": "${RESOURCE_TAGS}"
    },
    "datadogApiKey": {
      "value": "${DD_API_KEY}"
    },
    "datadogSite": {
      "value": "${DD_SITE=datadoghq.com}"
    },
    "demoDagSchedule": {
      "value": "${DEMO_DAG_SCHEDULE=*/5 * * * *}"
    },
    "datadogOtelSignals": {
      "value": "${TELEMETRY_SIGNALS=traces,metrics,logs}"
    },
    "datadogEnv": {
      "value": "${DD_ENV=airflow-aca}"
    },
    "enableDataPipeline": {
      "value": "${ENABLE_DATA_PIPELINE=false}"
    },
    "datadogPostgresPassword": {
      "value": "${DD_POSTGRES_PASSWORD}"
    },
    "enableOrderStream": {
      "value": "${ENABLE_ORDER_STREAM=false}"
    }
  }
}
